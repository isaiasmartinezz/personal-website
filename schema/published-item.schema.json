{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isaiasmartinez.dev/schema/published-item.schema.json",
  "title": "PublishedItem",
  "description": "One approved, redacted item exported by the life dashboard Publisher. schemaVersion is bumped on any breaking change.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "type", "tier", "slug", "title", "date", "updatedAt", "body", "tags", "photos", "data"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/identifier" },
    "type": { "enum": ["journal", "place", "film", "trip", "hike", "recipe", "collection_entry"] },
    "tier": { "enum": ["public", "friends"] },
    "slug": { "$ref": "#/$defs/identifier" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "date": { "type": "string", "format": "date" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "body": { "type": "string", "description": "Markdown. Raw HTML and remote images are ignored by the renderer." },
    "rating": { "type": "number", "minimum": 0, "maximum": 5, "description": "Normalized to 0-5." },
    "sourceRating": { "type": "string", "maxLength": 80, "description": "The rating as shown at its source, for display." },
    "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 60 } },
    "location": { "$ref": "#/$defs/location" },
    "photos": { "type": "array", "items": { "$ref": "#/$defs/photo" } },
    "data": { "type": "object" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": { "enum": ["letterboxd", "beli", "strava", "gpx", "manual"] },
        "sourceUrl": { "type": "string", "format": "uri" }
      }
    }
  },
  "allOf": [
    { "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "journal" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/journalData" } } } },
    { "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "place" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/placeData" } } } },
    { "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "film" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/filmData" } } } },
    { "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "trip" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/tripData" } } } },
    { "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "hike" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/hikeData" } } } },
    { "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "recipe" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/recipeData" } } } },
    { "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "collection_entry" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/collectionEntryData" } } } }
  ],
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 120 },
    "mediaPath": { "type": "string", "pattern": "^/life-media/[A-Za-z0-9._/-]+\\.(jpg|jpeg|png|webp)$" },
    "photo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "width", "height", "alt"],
      "properties": {
        "path": { "$ref": "#/$defs/mediaPath" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "alt": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "lat", "lng"],
      "description": "Already rounded by the Publisher; the validator rejects more than 3 decimal places (about 100 m).",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "city": { "type": "string" },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "journalData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weekNumber", "kind"],
      "properties": {
        "weekNumber": { "type": "integer", "minimum": 1, "maximum": 53 },
        "kind": { "enum": ["recap", "essay"] },
        "coverPhoto": { "$ref": "#/$defs/mediaPath" }
      }
    },
    "placeData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cuisine", "priceLevel", "visitDates", "dishes"],
      "properties": {
        "cuisine": { "type": "string", "minLength": 1 },
        "priceLevel": { "type": "integer", "minimum": 1, "maximum": 4 },
        "visitDates": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "date" } },
        "dishes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "destinationId": { "$ref": "#/$defs/identifier" }
      }
    },
    "filmData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["year", "director", "posterPath", "watchedDate", "rewatch"],
      "properties": {
        "year": { "type": "integer", "minimum": 1888, "maximum": 2100 },
        "director": { "type": "string", "minLength": 1 },
        "posterPath": { "$ref": "#/$defs/mediaPath" },
        "watchedDate": { "type": "string", "format": "date" },
        "rewatch": { "type": "boolean" },
        "letterboxdUrl": { "type": "string", "format": "uri" }
      }
    },
    "tripData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["destination", "startDate", "endDate", "days"],
      "properties": {
        "destination": { "type": "string", "minLength": 1 },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "days": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stops"],
            "properties": {
              "label": { "type": "string" },
              "stops": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name"],
                  "properties": { "name": { "type": "string", "minLength": 1 }, "note": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    },
    "hikeData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trailName", "distanceKm", "elevationGainM", "durationMin"],
      "properties": {
        "trailName": { "type": "string", "minLength": 1 },
        "distanceKm": { "type": "number", "minimum": 0 },
        "elevationGainM": { "type": "number", "minimum": 0 },
        "durationMin": { "type": "number", "minimum": 0 },
        "trackGeoJson": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "coordinates"],
          "description": "Simplified LineString; the Publisher trims the first and last 500 m. Positions are [lng, lat] or [lng, lat, elevation].",
          "properties": {
            "type": { "const": "LineString" },
            "coordinates": {
              "type": "array",
              "minItems": 2,
              "items": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "type": "number" } }
            }
          }
        }
      }
    },
    "recipeData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "servings", "proteinPerServing", "ingredients", "steps"],
      "properties": {
        "kind": { "enum": ["meal", "creami"] },
        "servings": { "type": "number", "exclusiveMinimum": 0 },
        "proteinPerServing": { "type": "number", "minimum": 0 },
        "ingredients": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["item"],
            "properties": { "item": { "type": "string", "minLength": 1 }, "quantity": { "type": "string" } }
          }
        },
        "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "collectionEntryData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collection", "status"],
      "properties": {
        "collection": { "enum": ["board-games", "cheeses"] },
        "status": { "enum": ["played", "tried", "owned"] }
      }
    }
  }
}
